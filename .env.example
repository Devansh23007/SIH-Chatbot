# Google Gemini API Key (Required for embeddings and fallback LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional but recommended for fast inference)
GROQ_API_KEY=your_groq_api_key_here

# RAG Relevance Thresholds (Tune using backend/calibrate_threshold.py)
STRONG_MATCH=0.70
WEAK_MATCH=0.55
